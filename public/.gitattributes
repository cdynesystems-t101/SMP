# Strict binary settings for all image assets (prevents Git CRLF/UTF-8 corruption on Windows)
*.png binary -text -crlf
*.jpg binary -text -crlf
*.jpeg binary -text -crlf
*.gif binary -text -crlf
*.ico binary -text -crlf
*.webp binary -text -crlf
*.svg text eol=lf
*.json text eol=lf
*.webmanifest text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
